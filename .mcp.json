{
  "mcpServers": {
    "prusaslicer": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/mcp/prusaslicer_mcp_server.py"
      ],
      "env": {
        "PRUSASLICER_BIN": "/Applications/Original Prusa Drivers/PrusaSlicer.app/Contents/MacOS/PrusaSlicer",
        "MCO_REPO_ROOT": "."
      }
    },
    "agentcad": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "agentcad.mcp"
      ],
      "env": {
        "AGENTCAD_RUN_TIMEOUT_S": "600"
      }
    },
    "fusion": {
      "type": "http",
      "url": "http://127.0.0.1:27182/mcp"
    }
  }
}
