[Unit]
Description=MCO-1D Touchscreen Panel
After=mco-flight.service
Requires=mco-flight.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/mco_panel.py
Environment=SDL_VIDEODRIVER=fbcon
Environment=SDL_FBDEV=/dev/fb0
Environment=DISPLAY=
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
